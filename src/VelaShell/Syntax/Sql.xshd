<?xml version="1.0" encoding="utf-8"?>
<!-- 通用 SQL:MySQL / PostgreSQL / SQLite 的公共子集。以前 .sql 走 AvaloniaEdit 内置的 TSQL,
     那份定义只认 SQL Server 方言,而服务器上碰到的 dump 与迁移脚本绝大多数是前三者。
     颜色见 Shell.xshd 顶部说明。 -->
<SyntaxDefinition name="SQL" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

  <Color name="Comment"     foreground="#6272A4" />
  <Color name="String"      foreground="#F1FA8C" />
  <Color name="Keyword"     foreground="#FF79C6" />
  <Color name="Type"        foreground="#8BE9FD" />
  <Color name="Function"    foreground="#50FA7B" />
  <Color name="Variable"    foreground="#FFB86C" />
  <Color name="Constant"    foreground="#BD93F9" />
  <Color name="Number"      foreground="#BD93F9" />
  <Color name="Punctuation" foreground="#F8F8F2" />

  <RuleSet ignoreCase="true">

    <Span color="Comment" begin="--" />

    <Span color="Comment" multiline="true">
      <Begin>/\*</Begin>
      <End>\*/</End>
    </Span>

    <!-- 字符串里的 '' 是转义出来的单引号:结束后紧接着又开始,效果上仍是一整段。 -->
    <Span color="String" multiline="true">
      <Begin>'</Begin>
      <End>'</End>
    </Span>

    <!-- 引号标识符:PostgreSQL 的 "name" 与 MySQL 的 `name`。 -->
    <Span color="Variable" multiline="false">
      <Begin>"</Begin>
      <End>"</End>
    </Span>

    <Span color="Variable" multiline="false">
      <Begin>`</Begin>
      <End>`</End>
    </Span>

    <!-- 会话变量 @x / @@x 与占位参数 $1。 -->
    <Rule color="Variable">
      @@?[A-Za-z_][A-Za-z0-9_]*|\$\d+
    </Rule>

    <Keywords color="Keyword">
      <Word>select</Word>
      <Word>from</Word>
      <Word>where</Word>
      <Word>insert</Word>
      <Word>into</Word>
      <Word>values</Word>
      <Word>update</Word>
      <Word>set</Word>
      <Word>delete</Word>
      <Word>create</Word>
      <Word>table</Word>
      <Word>alter</Word>
      <Word>drop</Word>
      <Word>add</Word>
      <Word>column</Word>
      <Word>index</Word>
      <Word>view</Word>
      <Word>primary</Word>
      <Word>key</Word>
      <Word>foreign</Word>
      <Word>references</Word>
      <Word>not</Word>
      <Word>default</Word>
      <Word>unique</Word>
      <Word>check</Word>
      <Word>constraint</Word>
      <Word>join</Word>
      <Word>inner</Word>
      <Word>left</Word>
      <Word>right</Word>
      <Word>full</Word>
      <Word>outer</Word>
      <Word>cross</Word>
      <Word>on</Word>
      <Word>using</Word>
      <Word>group</Word>
      <Word>by</Word>
      <Word>order</Word>
      <Word>having</Word>
      <Word>limit</Word>
      <Word>offset</Word>
      <Word>union</Word>
      <Word>all</Word>
      <Word>distinct</Word>
      <Word>as</Word>
      <Word>and</Word>
      <Word>or</Word>
      <Word>in</Word>
      <Word>is</Word>
      <Word>like</Word>
      <Word>ilike</Word>
      <Word>between</Word>
      <Word>exists</Word>
      <Word>case</Word>
      <Word>when</Word>
      <Word>then</Word>
      <Word>else</Word>
      <Word>end</Word>
      <Word>begin</Word>
      <Word>commit</Word>
      <Word>rollback</Word>
      <Word>transaction</Word>
      <Word>grant</Word>
      <Word>revoke</Word>
      <Word>truncate</Word>
      <Word>if</Word>
      <Word>replace</Word>
      <Word>database</Word>
      <Word>schema</Word>
      <Word>returning</Word>
      <Word>with</Word>
      <Word>recursive</Word>
      <Word>asc</Word>
      <Word>desc</Word>
      <Word>auto_increment</Word>
      <Word>cascade</Word>
      <Word>trigger</Word>
      <Word>procedure</Word>
      <Word>function</Word>
      <Word>returns</Word>
      <Word>declare</Word>
      <Word>language</Word>
      <Word>explain</Word>
      <Word>analyze</Word>
      <Word>vacuum</Word>
      <Word>show</Word>
      <Word>use</Word>
      <Word>engine</Word>
      <Word>charset</Word>
      <Word>collate</Word>
    </Keywords>

    <Keywords color="Type">
      <Word>int</Word>
      <Word>integer</Word>
      <Word>bigint</Word>
      <Word>smallint</Word>
      <Word>tinyint</Word>
      <Word>serial</Word>
      <Word>bigserial</Word>
      <Word>decimal</Word>
      <Word>numeric</Word>
      <Word>float</Word>
      <Word>double</Word>
      <Word>real</Word>
      <Word>char</Word>
      <Word>varchar</Word>
      <Word>text</Word>
      <Word>blob</Word>
      <Word>boolean</Word>
      <Word>bool</Word>
      <Word>date</Word>
      <Word>time</Word>
      <Word>timestamp</Word>
      <Word>timestamptz</Word>
      <Word>datetime</Word>
      <Word>interval</Word>
      <Word>json</Word>
      <Word>jsonb</Word>
      <Word>uuid</Word>
      <Word>bytea</Word>
    </Keywords>

    <Keywords color="Constant">
      <Word>true</Word>
      <Word>false</Word>
      <Word>null</Word>
    </Keywords>

    <Rule color="Function">
      \b[A-Za-z_][A-Za-z0-9_]*(?=\s*\()
    </Rule>

    <Rule color="Number">
      \b\d+(\.\d+)?([eE][+-]?\d+)?\b
    </Rule>

    <Rule color="Punctuation">
      [(),;.=&lt;&gt;!*+\-/%|:]
    </Rule>

  </RuleSet>
</SyntaxDefinition>
