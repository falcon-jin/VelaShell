<?xml version="1.0" encoding="utf-8"?>
<!-- Lua。OpenResty 的 content_by_lua、Redis 的 EVAL 脚本、Neovim 配置都是它。
     颜色见 Shell.xshd 顶部说明。 -->
<SyntaxDefinition name="Lua" xmlns="http://icsharpcode.net/sharpdevelop/syntaxdefinition/2008">

  <Color name="Comment"     foreground="#6272A4" />
  <Color name="String"      foreground="#F1FA8C" />
  <Color name="Keyword"     foreground="#FF79C6" />
  <Color name="Function"    foreground="#50FA7B" />
  <Color name="Constant"    foreground="#BD93F9" />
  <Color name="Number"      foreground="#BD93F9" />
  <Color name="Punctuation" foreground="#F8F8F2" />

  <RuleSet ignoreCase="false">

    <!-- 块注释(双横线加双方括号)必须排在行注释(双横线)之前。
         注意:XML 注释里不能出现两个连续的横线,所以这里不能照写 Lua 的注释符号。 -->
    <Span color="Comment" multiline="true">
      <Begin>--\[\[</Begin>
      <End>\]\]</End>
    </Span>

    <Span color="Comment" begin="--" />

    <Span color="String" multiline="true">
      <Begin>\[\[</Begin>
      <End>\]\]</End>
    </Span>

    <Span color="String" multiline="false">
      <Begin>"</Begin>
      <End>"</End>
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>

    <Span color="String" multiline="false">
      <Begin>'</Begin>
      <End>'</End>
      <RuleSet>
        <Span begin="\\" end="." />
      </RuleSet>
    </Span>

    <Keywords color="Keyword">
      <Word>and</Word>
      <Word>break</Word>
      <Word>do</Word>
      <Word>else</Word>
      <Word>elseif</Word>
      <Word>end</Word>
      <Word>for</Word>
      <Word>function</Word>
      <Word>goto</Word>
      <Word>if</Word>
      <Word>in</Word>
      <Word>local</Word>
      <Word>not</Word>
      <Word>or</Word>
      <Word>repeat</Word>
      <Word>return</Word>
      <Word>then</Word>
      <Word>until</Word>
      <Word>while</Word>
    </Keywords>

    <Keywords color="Constant">
      <Word>true</Word>
      <Word>false</Word>
      <Word>nil</Word>
    </Keywords>

    <Rule color="Function">
      \b[A-Za-z_][A-Za-z0-9_]*(?=\s*[("{])
    </Rule>

    <Rule color="Number">
      \b(0[xX][0-9a-fA-F]+|\d+(\.\d+)?([eE][+-]?\d+)?)\b
    </Rule>

    <Rule color="Punctuation">
      [{}()\[\];,.:=&lt;&gt;~#+\-*/%^]
    </Rule>

  </RuleSet>
</SyntaxDefinition>
